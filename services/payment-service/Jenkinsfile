pipeline {
    agent any
    environment {
        AWS_REGION = 'us-east-2'
        ECR_REPOSITORY = 'payment-service'
        // Using lazy evaluation string for the build number
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // Wrapping the remaining execution inside a single dir block reduces clutter
        stage('Payment Service Pipeline') {
            steps {
                dir('services/payment-service') {
                    script {
                        // 1. Install Dependencies
                        sh 'npm ci'
                        
                        // 2. Run Tests
                        sh 'npm test'
                        
                        // 3. Build Docker Image (Using double-quotes so Jenkins resolves variables)
                        sh """
                            docker build \
                                -t ${ECR_REPOSITORY}:${IMAGE_TAG} \
                                .
                        """
                        
                        // 4. Security Scan using Trivy
                        sh """
                            trivy image \
                                --severity HIGH,CRITICAL \
                                --exit-code 1 \
                                ${ECR_REPOSITORY}:${IMAGE_TAG}
                        """
                        
                        // 5. Authenticate and Push to ECR
                        sh """
                            AWS_ACCOUNT_ID=\$(aws sts get-caller-identity --query Account --output text)
                            ECR_URL=\${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                            aws ecr get-login-password --region ${AWS_REGION} | \
                                docker login --username AWS --password-stdin \${ECR_URL}

                            docker tag ${ECR_REPOSITORY}:${IMAGE_TAG} \${ECR_URL}/${ECR_REPOSITORY}:${IMAGE_TAG}
                            docker push \${ECR_URL}/${ECR_REPOSITORY}:${IMAGE_TAG}
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Payment service CI pipeline completed successfully.'
        }
        failure {
            echo 'Payment service CI pipeline failed.'
        }
    }
}